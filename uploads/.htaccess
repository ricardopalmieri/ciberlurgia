# Uploads: só imagens, e nada aqui é executado como script.
Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
  RemoveType .php .phtml .phar
</IfModule>
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>

# Nega tudo, exceto webp/jpg/png
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "^[A-Za-z0-9][A-Za-z0-9_-]*\.(webp|jpe?g|png)$">
  Require all granted
</FilesMatch>
